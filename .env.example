# Telegram
TELEGRAM_BOT_TOKEN=COLOQUE_O_TOKEN_DO_BOTFATHER

# Modo de dados: simulation (testes do TSE) ou official (eleição real)
ELECTION_MODE=simulation

# Frequência de consulta. A CDN do TSE limita 100 req/s por IP.
POLL_SECONDS=20
REQUEST_TIMEOUT=12

# Banco local
DATABASE_PATH=data/election_bot.db

# IDs de administradores separados por vírgula (opcional)
ADMIN_IDS=

# Canal padrão para /publicar (ex.: @SeuCanal ou -1001234567890)
CHANNEL_ID=

# Porta usada localmente/Railway
PORT=8000

# Depois do deploy, informe a URL pública para aparecer um botão de painel no Telegram
WEBAPP_URL=

# Sobrescritas opcionais. Normalmente não precisa alterar.
# TSE_BASE_URL=https://resultados-sim.tse.jus.br/simulado
# TSE_ENVIRONMENT=simulado2026
# TSE_ELECTION_CODE=21270
# TSE_CYCLE=ele2026
# TSE_PRESIDENT_CARGO=0001
