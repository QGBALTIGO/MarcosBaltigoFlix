# Telegram
TELEGRAM_BOT_TOKEN=COLOQUE_O_TOKEN_DO_BOTFATHER
ADMIN_IDS=
CHANNEL_ID=@ResultadoEleicoes
REQUIRED_CHANNEL=@ResultadoEleicoes
BOT_USERNAME=ResultadoEleicoes_Bot

# Apuração oficial TSE
ELECTION_MODE=official
PRESIDENT_POLL_SECONDS=2
POLL_SECONDS=10
REQUEST_TIMEOUT=8

# Persistência
DATABASE_PATH=data/election_bot.db

# Boletins de urna do exterior (pré-totalização oficial)
EXTERIOR_BU_ENABLED=true
EXTERIOR_BU_POLL_SECONDS=90
EXTERIOR_BU_SOURCE_URL=https://www.poder360.com.br/poder-eleicoes-2026/eleicoes-2026-exterior-resultados/

# Pesquisas G1
G1_DAILY_ENABLED=true
G1_DAILY_HOUR=9
G1_DAILY_MINUTE=0
G1_DAILY_INSTITUTE=Datafolha
G1_MONITOR_MINUTES=15
TIMEZONE=America/Campo_Grande

# App
PORT=8000
WEBAPP_URL=

